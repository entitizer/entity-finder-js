{
  "name": "entity-finder",
  "version": "2.0.0",
  "description": "Find named entities on Wikipedia: resolves a name to the most relevant Wikipedia pages, with Wikidata ids, short descriptions and disambiguation filtering.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "entity-finder": "dist/esm/cli.js"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/fixup.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src scripts test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "LIVE=1 vitest run test/live",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build",
    "preversion": "npm run check",
    "postversion": "git push --follow-tags",
    "find": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "wikipedia-data": "^1.0.0"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/entitizer/entity-finder-js.git"
  },
  "keywords": [
    "entity",
    "named-entity",
    "ner",
    "wikipedia",
    "wikidata",
    "entity-linking",
    "disambiguation",
    "finder"
  ],
  "author": "Dumitru Cantea",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/entitizer/entity-finder-js/issues"
  },
  "homepage": "https://github.com/entitizer/entity-finder-js#readme",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
